# =============================================================================
# FulinAI Environment Variables
# Copy this file to .env and fill in your values
# cp .env.example .env
# =============================================================================

# -----------------------------------------------------------------------------
# General
# -----------------------------------------------------------------------------
ENV=dev
LOG_LEVEL=INFO

# -----------------------------------------------------------------------------
# MySQL (shared by api-service + raw_data)
# -----------------------------------------------------------------------------
MYSQL_ROOT_PASSWORD=root
MYSQL_DATABASE=job_crawler
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=root
DB_NAME=job_crawler
DB_TYPE=mysql

# Job DB (can override shared defaults)
JOB_DB_HOST=${DB_HOST}
JOB_DB_PORT=${DB_PORT}
JOB_DB_USER=${DB_USER}
JOB_DB_PASSWORD=${DB_PASSWORD}
JOB_DB_NAME=job_crawler

# Resume DB (can override shared defaults)
RESUME_DB_HOST=${DB_HOST}
RESUME_DB_PORT=${DB_PORT}
RESUME_DB_USER=${DB_USER}
RESUME_DB_PASSWORD=${DB_PASSWORD}
RESUME_DB_NAME=resume_db

# -----------------------------------------------------------------------------
# Redis (cache + distributed lock + rate limiting)
# -----------------------------------------------------------------------------
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# -----------------------------------------------------------------------------
# Kafka (message queue, optional - not actively used in current version)
# -----------------------------------------------------------------------------
KAFKA_BOOTSTRAP_SERVERS=localhost:9092

# -----------------------------------------------------------------------------
# AI Service (Python / FastAPI)
# -----------------------------------------------------------------------------
PYTHONUNBUFFERED=1
API_SERVICE_HOST=0.0.0.0
API_SERVICE_PORT=8000

# Model settings
MODEL_PROVIDER=local
MODEL_NAME=Qwen3___5-4B
EMBEDDING_MODEL=

# JWT Authentication
JWT_SECRET=change-me-in-production-use-a-random-string-at-least-32-chars

# SQLite Memory (fallback if MySQL unavailable)
MEMORY_DB_PATH=

# -----------------------------------------------------------------------------
# API Gateway (Go / Gin)
# -----------------------------------------------------------------------------
GIN_MODE=debug
SERVER_PORT=8080
PYTHON_BASEURL=http://localhost:8000

# Go Gateway internal routes (usually no need to override)
PYTHON_AGENT_PATH=/api/agent
PYTHON_AGENT_STREAM_PATH=/api/agent/stream
PYTHON_RESUME_PATH=/api/resume

# -----------------------------------------------------------------------------
# Data Collector (raw_data / job crawler)
# -----------------------------------------------------------------------------
BATCH_SIZE=100
MAX_PAGES=10
REQUEST_DELAY=0.5
LOG_FILE=logs/collector.log

# Resume importer
RESUME_BATCH_SIZE=100
RESUME_MAX_BATCHES=10

# -----------------------------------------------------------------------------
# Flink Data Pipeline (Java, batch processing mode)
# -----------------------------------------------------------------------------
FLINK_JOB_MANAGER_RPC_ADDRESS=flink-jobmanager
FLINK_JOB_MANAGER_HEAP_SIZE=512m
FLINK_TASK_MANAGER_HEAP_SIZE=1g
FLINK_TASK_SLOTS=4

# -----------------------------------------------------------------------------
# Frontend (React / Vite)
# -----------------------------------------------------------------------------
VITE_API_BASE_URL=http://localhost:8080
NODE_ENV=development

# -----------------------------------------------------------------------------
# Docker / Deployment
# -----------------------------------------------------------------------------
COMPOSE_PROJECT_NAME=fulinai
