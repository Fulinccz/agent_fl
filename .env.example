# =============================================================================
# FulinAI Environment Variables
# Copy this file to .env and fill in your values
# cp .env.example .env
# =============================================================================

# -----------------------------------------------------------------------------
# General
# -----------------------------------------------------------------------------
ENV=dev
LOG_LEVEL=INFO

# -----------------------------------------------------------------------------
# MySQL
#   DB_*      → raw_data 爬虫/导入、Flink 作业读取
#   MYSQL_*   → api-service（AppSettings）读取，docker-compose 亦按此注入
# -----------------------------------------------------------------------------
MYSQL_ROOT_PASSWORD=root
MYSQL_DATABASE=job_crawler
# api-service 本地开发连接（docker 部署由 compose 注入容器网络地址）
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=root
MYSQL_DB=job_crawler

DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=root
DB_NAME=job_crawler
DB_TYPE=mysql

# Job DB (can override shared defaults)
JOB_DB_HOST=${DB_HOST}
JOB_DB_PORT=${DB_PORT}
JOB_DB_USER=${DB_USER}
JOB_DB_PASSWORD=${DB_PASSWORD}
JOB_DB_NAME=job_crawler

# Resume DB (can override shared defaults)
RESUME_DB_HOST=${DB_HOST}
RESUME_DB_PORT=${DB_PORT}
RESUME_DB_USER=${DB_USER}
RESUME_DB_PASSWORD=${DB_PASSWORD}
RESUME_DB_NAME=resume_db

# -----------------------------------------------------------------------------
# Redis (cache + distributed lock + rate limiting)
# -----------------------------------------------------------------------------
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# -----------------------------------------------------------------------------
# Kafka (message queue, optional - not actively used in current version)
# -----------------------------------------------------------------------------
KAFKA_BOOTSTRAP_SERVERS=localhost:9092

# -----------------------------------------------------------------------------
# AI Service (Python / FastAPI)
# -----------------------------------------------------------------------------
PYTHONUNBUFFERED=1
# 服务监听地址（AppSettings 通过 validation_alias 精确读取这两个变量名）
API_SERVICE_HOST=0.0.0.0
API_SERVICE_PORT=8000

# Embedding 模型路径（留空则用代码默认的本地 bge-small-zh 路径）
EMBEDDING_MODEL=

# 鉴权：Demo 默认关闭（前端无登录入口）；任何可被访问的环境必须置 true
AUTH_ENABLED=false
# JWT 密钥（AUTH_ENABLED=true 或 ENV=prod 时必填，>=32 位随机串：openssl rand -hex 32）
JWT_SECRET=
# CORS 白名单（逗号分隔；带凭证时不能用 *，如 https://app.example.com,https://admin.example.com）
CORS_ORIGINS=*
# 就绪探针是否检查 Kafka（主链路不依赖 Kafka，默认 false）
KAFKA_ENABLED=false

# SQLite Memory (fallback if MySQL unavailable)
MEMORY_DB_PATH=

# -----------------------------------------------------------------------------
# API Gateway (Go / Gin)
# -----------------------------------------------------------------------------
GIN_MODE=debug
SERVER_PORT=8080
PYTHON_BASEURL=http://localhost:8000

# 基于 IP 的令牌桶限流（每秒令牌数 / 突发容量）
GATEWAY_RATE_LIMIT=50
GATEWAY_RATE_BURST=100

# -----------------------------------------------------------------------------
# Data Collector (raw_data / job crawler)
# -----------------------------------------------------------------------------
BATCH_SIZE=100
MAX_PAGES=10
REQUEST_DELAY=0.5
LOG_FILE=logs/collector.log

# Resume importer
RESUME_BATCH_SIZE=100
RESUME_MAX_BATCHES=10

# -----------------------------------------------------------------------------
# Flink Data Pipeline (Java, batch processing mode)
# -----------------------------------------------------------------------------
FLINK_JOB_MANAGER_RPC_ADDRESS=flink-jobmanager
FLINK_JOB_MANAGER_HEAP_SIZE=512m
FLINK_TASK_MANAGER_HEAP_SIZE=1g
FLINK_TASK_SLOTS=4

# -----------------------------------------------------------------------------
# Frontend (React / Vite)
# -----------------------------------------------------------------------------
# 前端 API 基址（变量名必须是 VITE_API_URL；留空走同源 /api，经 nginx 转发到网关）
VITE_API_URL=http://localhost:8080
NODE_ENV=development

# -----------------------------------------------------------------------------
# Neo4j（可选，仅 --profile graph 启动图谱检索时需要）
# -----------------------------------------------------------------------------
NEO4J_PASSWORD=fulin123456

# -----------------------------------------------------------------------------
# Docker / Deployment
# -----------------------------------------------------------------------------
COMPOSE_PROJECT_NAME=fulinai
