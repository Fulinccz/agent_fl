# ---- build stage ----
FROM docker.io/library/golang:1.25-alpine3.22 AS build

WORKDIR /app

ENV GOPROXY=https://goproxy.cn,direct \
    CGO_ENABLED=0

# 先拷依赖清单，利用层缓存
COPY go.mod go.sum ./
RUN go mod download

COPY . .
RUN go build -ldflags="-s -w" -o main ./cmd/server

# ---- runtime stage ----
FROM docker.io/library/alpine:3.20

RUN apk --no-cache add ca-certificates wget \
    && addgroup -S app \
    && adduser -S app -G app \
    && mkdir -p /home/app

WORKDIR /home/app
COPY --from=build --chown=app:app /app/main ./main
COPY --from=build --chown=app:app /app/config ./config

USER app

EXPOSE 8080

HEALTHCHECK --interval=30s --timeout=3s --retries=3 \
  CMD wget --no-verbose --tries=1 --spider http://localhost:8080/health || exit 1

CMD ["./main"]
