# Langfuse 自托管环境变量模板
# 用法：cp .env.example .env，然后替换为本地生成的随机值，勿提交 .env
#
# 生成命令：
#   openssl rand -base64 32   # NEXTAUTH_SECRET
#   openssl rand -hex 32      # ENCRYPTION_KEY（64 位十六进制）
#   openssl rand -hex 16      # SALT
#   openssl rand -hex 16      # 其它密码/密钥

# 加密密钥（必填，修改 ENCRYPTION_KEY 会导致历史加密数据不可解密）
LANGFUSE_NEXTAUTH_SECRET=replace-with-openssl-rand-base64-32
LANGFUSE_SALT=replace-with-32-hex-chars
LANGFUSE_ENCRYPTION_KEY=replace-with-64-hex-chars

# 初始项目 API Key 与管理员密码（必填）
LANGFUSE_INIT_PROJECT_SECRET_KEY=sk-lf-replace-with-random-secret
LANGFUSE_INIT_USER_PASSWORD=replace-with-strong-password

# 初始化管理员邮箱（可选）
LANGFUSE_INIT_USER_EMAIL=admin@fulin.local

# 基础设施密码（可选，默认值仅供纯本地 demo；任何可被访问的环境都应修改）
LANGFUSE_DB_PASSWORD=langfuse_local
LANGFUSE_REDIS_PASSWORD=langfuse_redis_pass
LANGFUSE_CLICKHOUSE_PASSWORD=langfuse_local
LANGFUSE_MINIO_USER=minio_root
LANGFUSE_MINIO_PASSWORD=minio_root_pass_123
